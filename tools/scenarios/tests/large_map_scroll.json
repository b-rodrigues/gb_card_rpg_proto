{
  "name": "large_map_scroll",
  "test": true,
  "description": "Walk south on the Field (20x18 tiles) below the 12-row overworld view window; the camera scrolls down (scroll_y advances past 0) while scroll_x stays 0, proving the large-map data model + world->render scroll offset",
  "scenario_id": "LARGE_MAP_SCROLL",
  "actions": [
    {
      "type": "hold",
      "button": "DOWN",
      "frames": 72
    },
    {
      "type": "wait",
      "frames": 8
    }
  ],
  "assertions": [
    {
      "type": "game_state",
      "expected": "OVERWORLD"
    },
    {
      "type": "player_position",
      "expected_x": 2,
      "expected_y": 16
    },
    {
      "type": "camera",
      "expected_x": 0,
      "expected_y": 5
    },
    {
      "type": "scroll_x",
      "expected": 0
    },
    {
      "type": "scroll_y",
      "expected": 5
    },
    {
      "type": "world_height",
      "expected": 18
    }
  ],
  "initial_state": {
    "scene": "FIELD",
    "player": {
      "x": 2,
      "y": 7,
      "facing": "DOWN"
    },
    "seed": 1000,
    "flags": {
      "ARRIVED_TOWN": true
    }
  }
}
