{
  "name": "actor_mayor_interaction",
  "test": true,
  "description": "Friendly World Actor (Mayor) starts dialogue when engaged",
  "scenario_id": "MAYOR_DIALOGUE",
  "actions": [
    {
      "type": "press",
      "button": "RIGHT"
    },
    {
      "type": "wait",
      "frames": 5
    }
  ],
  "assertions": [
