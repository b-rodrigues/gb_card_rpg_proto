{
  "name": "town_reentry",
  "test": true,
  "description": "Re-enter Town when STORY_FLAG_ARRIVED_TOWN is already set (verifies no duplicate story flag event)",
  "scenario_id": "TOWN_REENTRY",
  "actions": [
    {
      "type": "press",
      "button": "RIGHT"
    }
  ],
  "assertions": [
    {
      "type": "game_state",
      "expected": "OVERWORLD"
    },
    {
      "type": "player_position",
      "expected_x": 2,
      "expected_y": 7
    },
    {
      "type": "event_occurred",
      "event": "MAP_CHANGED"
    },
    {
      "type": "event_not_occurred",
      "event": "STORY_FLAG_SET",
      "flag": "ARRIVED_TOWN"
    },
    {
      "type": "story_flag",
      "flag": "ARRIVED_TOWN",
      "expected": true
    }
  ],
  "initial_state": {
    "scene": "FIELD",
    "player": {
      "x": 17,
      "y": 7,
      "facing": "DOWN"
    },
    "seed": 1001,
    "flags": {
      "ARRIVED_TOWN": true
    }
  }
}
