      "expected": "MAYOR_GREETING"
    },
    {
      "type": "event_occurred",
      "event": "ACTOR_INTERACTION"
    },
    {
      "type": "actor_at",
      "entity": "MAYOR",
      "x": 10,
      "y": 5
    }
  ]
}
