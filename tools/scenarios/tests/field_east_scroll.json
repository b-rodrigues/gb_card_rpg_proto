{
  "name": "field_east_scroll",
  "test": true,
  "description": "Walk east across the Field (32x18 tiles, wider than the 20-col overworld view); the camera scrolls right (scroll_x advances) while scroll_y stays 0, proving horizontal camera scroll on a large map",
  "scenario_id": "FIELD_EAST_SCROLL",
  "actions": [
    {
      "type": "hold",
      "button": "RIGHT",
      "frames": 192
    },
    {
      "type": "wait",
      "frames": 8
    }
  ],
  "assertions": [
    {
      "type": "game_state",
      "expected": "OVERWORLD"
    },
    {
      "type": "player_position",
      "expected_x": 26,
      "expected_y": 7
    },
    {
      "type": "camera",
      "expected_x": 7,
      "expected_y": 0
    },
    {
      "type": "scroll_x",
      "expected": 7
    },
    {
      "type": "scroll_y",
      "expected": 0
    },
    {
      "type": "world_width",
      "expected": 32
    }
  ],
  "initial_state": {
    "scene": "FIELD",
    "player": {
      "x": 2,
      "y": 7,
      "facing": "RIGHT"
    },
    "seed": 1000,
    "flags": {
      "ARRIVED_TOWN": true
    }
  }
}
