{
  "name": "mayor_encounter",
  "test": true,
  "description": "Approach Mayor NPC in Town to trigger dialogue overlay",
  "scenario_id": "MAYOR_ENCOUNTER",
  "actions": [
    {
      "type": "press",
      "button": "RIGHT"
    }
  ],
  "assertions": [
    {
      "type": "game_state",
      "expected": "OVERWORLD"
    },
    {
      "type": "player_facing",
      "expected": "RIGHT"
    },
    {
      "type": "event_occurred",
      "event": "DIALOGUE_STARTED"
    },
    {
      "type": "dialogue_active",
      "expected": true
    },
    {
      "type": "dialogue_line",
      "expected": 0
    }
  ]
}
